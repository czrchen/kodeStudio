---
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import { authConfigured, checkPassword, isAdmin, startSession } from '../../lib/auth';

if (isAdmin(Astro.cookies)) return Astro.redirect('/admin');

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (checkPassword(String(form.get('password') ?? ''))) {
    startSession(Astro.cookies);
    return Astro.redirect('/admin');
  }
  await new Promise((r) => setTimeout(r, 600)); // slow down guessing
  error = authConfigured() ? 'Incorrect password.' : 'Admin login is not configured. Set ADMIN_PASSWORD and SESSION_SECRET.';
}
---
<Base title="Admin login — KodeStudio" noindex>
  <main class="wrap">
    <form method="post" class="card">
      <Logo />
      <h1>Admin portal</h1>
      <p>Sign in to manage enquiries and bookings.</p>
      <div class="field">
        <label for="pw">Password</label>
        <input class="input" id="pw" name="password" type="password" required autofocus autocomplete="current-password" />
      </div>
      {error && <div class="form-msg error">{error}</div>}
      <button class="btn btn-primary" type="submit">Sign in</button>
      {import.meta.env.DEV && !error && <p class="hint">Local dev: password is <code>admin</code> unless ADMIN_PASSWORD is set.</p>}
    </form>
  </main>
</Base>
<style>
  .wrap { min-height: 100vh; display: grid; place-items: center; padding: 24px 16px; background: var(--bg-soft); }
  .card { width: 100%; max-width: 400px; display: grid; gap: 18px; background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 32px; box-shadow: var(--shadow); }
  h1 { font-size: 24px; margin-top: 12px; }
  p { color: var(--ink-2); font-size: 15px; margin-top: -10px; }
  .btn { height: 46px; }
  .hint { font-size: 13px; color: var(--ink-3); margin: 0; }
</style>
