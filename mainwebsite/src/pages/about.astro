---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappLink } from '../config';

export const prerender = true;

const principles = [
  {
    icon: 'layers',
    title: 'Start with the real process',
    text: 'We map how work moves through your team today, including the spreadsheets, messages and approvals people actually use.',
  },
  {
    icon: 'zap',
    title: 'Make the smallest useful change',
    text: 'We automate the part that saves the most time first, then connect more workflows only when the value is clear.',
  },
  {
    icon: 'key',
    title: 'Keep your business in control',
    text: 'Your accounts, data and workflows remain under your ownership, with a clear handover after launch.',
  },
];

const capabilities = [
  'WhatsApp and customer follow-ups',
  'Google Sheets and Excel workflows',
  'AI document and receipt processing',
  'Approvals, claims and internal requests',
  'Sales, operations and management reporting',
  'Connections between the tools you already use',
];
---

<Base
  title={`About ${site.name} | Workflow Automation for Malaysian SMEs`}
  description="Meet KodeSME, a Malaysia-based workflow automation partner helping SMEs reduce repetitive admin with WhatsApp, Google Sheets, Excel and AI."
>
  <Header />
  <main>
    <section class="about-hero">
      <div class="container hero-grid">
        <div>
          <span class="eyebrow">About KodeSME</span>
          <h1>Practical automation for the way Malaysian SMEs work.</h1>
        </div>
        <div class="intro">
          <p><strong>KodeSME</strong> is a Malaysia-based workflow automation partner for small and medium-sized businesses.</p>
          <p>We turn repetitive work across sales, HR, finance and operations into reliable workflows, using familiar tools instead of forcing teams into a complicated new system.</p>
        </div>
      </div>
    </section>

    <section class="section story">
      <div class="container split">
        <div>
          <span class="eyebrow">Why KodeSME</span>
          <h2>Good automation should feel simple.</h2>
          <p>Many growing businesses lose time to copy-paste work, missed follow-ups and approvals scattered across chats. The answer is rarely another large platform. It is a clear process with the repetitive steps handled automatically.</p>
          <p>KodeSME designs around your current team, tools and approval rules. Every project begins with a focused consultation and a fixed scope, then moves through testing, launch and handover.</p>
        </div>
        <aside class="cap-card">
          <span>What we automate</span>
          <ul>
            {capabilities.map((item) => <li><Icon name="check" size={16} /> {item}</li>)}
          </ul>
        </aside>
      </div>
    </section>

    <section class="section section-soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">How we work</span>
          <h2>Built around people, process and ownership.</h2>
        </div>
        <div class="principles">
          {principles.map((principle, index) => (
            <article>
              <div class="article-top"><span>{String(index + 1).padStart(2, '0')}</span><Icon name={principle.icon} size={21} /></div>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="container cta-inner">
        <div>
          <h2>Show us the work that slows your team down.</h2>
          <p>We will help you identify the first process worth automating.</p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-primary" href="/book">Book a free call <Icon name="arrow" size={16} /></a>
          <a class="btn btn-outline-light" href={whatsappLink()} target="_blank" rel="noopener">WhatsApp us</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .about-hero { padding: 112px 0 96px; background: var(--bg-soft); border-bottom: 1px solid var(--line); }
  .hero-grid { display: grid; grid-template-columns: 1.08fr 0.92fr; gap: 96px; align-items: end; }
  h1 { max-width: 760px; margin-top: 18px; font-size: clamp(44px, 6vw, 76px); line-height: 0.98; letter-spacing: -0.055em; }
  .intro { max-width: 590px; padding-bottom: 6px; }
  .intro p { color: var(--ink-2); font-size: clamp(18px, 2vw, 22px); line-height: 1.55; }
  .intro p + p { margin-top: 18px; }
  .intro strong { color: var(--ink); }
  .split { display: grid; grid-template-columns: 1fr 0.84fr; gap: 96px; align-items: start; }
  .split h2 { max-width: 600px; margin: 14px 0 24px; }
  .split > div > p { max-width: 680px; color: var(--ink-2); font-size: 18px; line-height: 1.72; }
  .split > div > p + p { margin-top: 18px; }
  .cap-card { padding: 32px; border: 1px solid var(--line); border-radius: 20px; background: #fff; box-shadow: 0 18px 50px rgba(20, 23, 21, 0.06); }
  .cap-card > span { display: block; margin-bottom: 20px; color: var(--ink-3); font-family: var(--mono); font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; }
  .cap-card ul { display: grid; gap: 15px; }
  .cap-card li { display: flex; gap: 10px; align-items: flex-start; color: var(--ink-2); }
  .cap-card li :global(svg) { flex: 0 0 auto; margin-top: 3px; color: var(--accent); }
  .principles { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 52px; border: 1px solid var(--line); border-radius: 20px; overflow: hidden; background: #fff; }
  .principles article { min-height: 290px; padding: 32px; }
  .principles article + article { border-left: 1px solid var(--line); }
  .article-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 54px; color: var(--brand); }
  .article-top span { color: var(--ink-3); font-family: var(--mono); font-size: 12px; }
  .principles h3 { margin-bottom: 12px; font-size: 23px; }
  .principles p { color: var(--ink-2); line-height: 1.65; }
  .cta-band { padding: 72px 0; background: var(--bg-ink); color: #fff; }
  .cta-inner { display: flex; justify-content: space-between; gap: 40px; align-items: center; }
  .cta-inner h2 { color: #fff; font-size: clamp(30px, 4vw, 48px); }
  .cta-inner p { margin-top: 10px; color: #aab3c5; font-size: 18px; }
  .cta-actions { display: flex; gap: 12px; flex: 0 0 auto; }
  @media (max-width: 900px) {
    .about-hero { padding: 84px 0 72px; }
    .hero-grid, .split { grid-template-columns: 1fr; gap: 40px; }
    .principles { grid-template-columns: 1fr; }
    .principles article { min-height: 0; }
    .principles article + article { border-left: 0; border-top: 1px solid var(--line); }
    .article-top { margin-bottom: 32px; }
    .cta-inner { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 560px) {
    .about-hero { padding: 68px 0 56px; }
    h1 { font-size: 42px; }
    .cta-actions { width: 100%; flex-direction: column; }
    .cta-actions .btn { justify-content: center; }
  }
</style>
