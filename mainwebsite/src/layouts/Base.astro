---
import '../styles/global.css';
import { site } from '../config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const defaultDescription = 'KodeStudio builds custom workflow automation for Malaysian SMEs, including WhatsApp automation, Google Sheets, Excel, AI document processing and approval workflows.';
const {
  title = `Workflow Automation Malaysia for SMEs | ${site.name}`,
  description = defaultDescription,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.name,
      alternateName: 'Kode Studio',
      description: defaultDescription,
      inLanguage: 'en-MY',
    },
    {
      '@type': 'Organization',
      '@id': `${site.url}/#organization`,
      name: site.name,
      alternateName: 'Kode Studio',
      url: site.url,
      logo: `${site.url}/logo-512.png`,
      image: `${site.url}/og-image.png`,
      description: defaultDescription,
      email: site.email,
      telephone: `+${site.whatsapp}`,
      areaServed: { '@type': 'Country', name: 'Malaysia' },
      knowsAbout: [
        'Business process automation',
        'Workflow automation',
        'WhatsApp automation',
        'Google Sheets automation',
        'Excel automation',
        'AI document processing',
        'CRM automation',
      ],
    },
    ...(Astro.url.pathname === '/'
      ? [{
          '@type': 'Service',
          '@id': `${site.url}/#automation-service`,
          name: 'Workflow automation for Malaysian SMEs',
          serviceType: 'Business process and workflow automation',
          description: defaultDescription,
          url: site.url,
          provider: { '@id': `${site.url}/#organization` },
          areaServed: { '@type': 'Country', name: 'Malaysia' },
        }]
      : []),
  ],
};
---
<!doctype html>
<html lang="en-MY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon-black.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#141715" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="KodeStudio workflow automation for Malaysian SMEs" />
    <meta property="og:locale" content="en_MY" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />
    <link rel="alternate" hreflang="en-MY" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    {!noindex && (
      <script is:inline>
        try {
          var u = new URLSearchParams(location.search).get('utm_source');
          navigator.sendBeacon('/api/track', JSON.stringify({ path: location.pathname, referrer: document.referrer, utm: u, width: innerWidth }));
        } catch (e) {}
      </script>
    )}
  </body>
</html>
