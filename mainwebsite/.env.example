# Neon Postgres connection string (Neon dashboard → Connect → copy the pooled URL).
# Leave empty during local development to use a built-in local database (.data/).
DATABASE_URL=

# Password for /admin
ADMIN_PASSWORD=

# Long random string used to sign admin login cookies.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# WhatsApp alerts for new enquiries and bookings (CallMeBot).
# Get a key: save +34 694 25 79 72 in your contacts, then WhatsApp it:
#   I allow callmebot to send me messages
# Leave empty to turn alerts off.
CALLMEBOT_APIKEY=
# Number that receives alerts, international format without "+". Defaults to the site WhatsApp number.
CALLMEBOT_PHONE=
