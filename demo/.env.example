# Neon connection string for the "demo" database (separate from the main website's data)
DATABASE_URL=

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.8-flash)
GEMINI_MODEL=

# Google Sheet sync (presenter mode only). See README for setup.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service account JSON, keeping the \n sequences, wrapped in double quotes
GOOGLE_PRIVATE_KEY=
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=

# Password to turn on presenter mode (enables Google Sheet sync)
PRESENTER_PASSWORD=
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=
